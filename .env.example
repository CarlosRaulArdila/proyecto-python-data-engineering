# ============================================================
# Plantilla de variables de entorno
# Copie este archivo como .env y reemplace los valores.
# El archivo .env NUNCA debe subirse al repositorio.
# ============================================================

# --- Conexión al data warehouse (PostgreSQL) -----------------
DB_HOST=localhost
DB_PORT=5434
DB_NAME=hospital_dw
DB_USER=etl_usuario
DB_PASSWORD=cambie_esta_clave

# --- docker-compose.yml de este repositorio ------------------
# Puerto del host para el PostgreSQL del compose (5435 evita
# chocar con el warehouse del entorno de Airflow en 5434).
WAREHOUSE_PORT=5435
ETL_IMAGE_TAG=2.1.0

# --- Identificación de la ejecución (opcionales) -------------
# ETL_ORCHESTRATOR=manual
# ETL_PIPELINE_ID=hospital_etl_pipeline
# ETL_PIPELINE_VERSION=2.1.0
# ETL_ENVIRONMENT=desarrollo

# --- Alertas por correo (opcional) -----------------------------
# Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords; requiere verificación en 2 pasos).
# ETL_SMTP_HOST=smtp.gmail.com
# ETL_SMTP_PUERTO=587
# ETL_SMTP_USUARIO=tu_cuenta@gmail.com
# ETL_SMTP_CLAVE=xxxx xxxx xxxx xxxx
# ETL_SMTP_REMITENTE=tu_cuenta@gmail.com
# ETL_ALERTA_DESTINATARIOS=persona1@empresa.com,persona2@empresa.com

# --- Alertas por webhook (opcional) ----------------------------
# ETL_ALERTA_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Configuración alternativa (opcional) --------------------
# ETL_CONFIG_PATH=/ruta/a/otra/config.yaml
